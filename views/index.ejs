<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>
  
  <a href="/new">Add a new message</a>
  <hr>

  <ul>
    <% messages.forEach((message) => { %>
      <li>
        <strong><%= message.user %></strong>: <%= message.text %> 
        <em>(<%= message.added.toLocaleTimeString() %>)</em>
      </li>
    <% }) %>
  </ul>
</body>
</html>
